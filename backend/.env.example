# Backend Environment Variables — copy to .env and customize

# Production: MongoDB Atlas
# DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/autolearn?retryWrites=true&w=majority"
# Local/Testing: Local MongoDB container
DATABASE_URL="mongodb://localhost:27017/autolearn?replicaSet=rs0&directConnection=true"

# Security
JWT_SECRET=change_this_to_a_secure_random_64_char_secret_in_production
PORT=3001
NODE_ENV=development

# Distributed Rate Limiting & Caching
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=autolearn-media

# CORS Policy
CORS_ORIGIN=*

# Password-reset emails. APP_URL is where the Flutter web app is served (the
# reset link points there). Without SMTP_URL, reset links are printed to the
# server console in development.
APP_URL=http://localhost:8080
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM=AutoLearn <no-reply@example.com>

# External API Integrations (the AI tutor, quiz generator and assignment
# feedback all run server-side and are disabled without OPENAI_API_KEY)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
STRIPE_SECRET_KEY=your_stripe_secret_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here
