datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String   @unique
  password    String
  displayName String?
  role        String   @default("student") // "student", "teacher" or "admin"
  phone       String?
  grade       String?
  interest    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  enrollments Enrollment[]
  progress    Progress[]
  chatSessions ChatSession[]
  payments    Payment[]
  certificates Certificate[]
  notifications Notification[]
  quizResults   QuizResult[]
  passwordResets PasswordReset[]
  quizSubmissions QuizSubmission[]
  assignmentSubmissions AssignmentSubmission[]
  bookmarks     Bookmark[]
  forumThreads  ForumThread[]
  forumReplies  ForumReply[]
}

model Course {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String
  instructor      String   @default("Admin")
  category        String   @default("General")
  level           String   @default("beginner")
  duration        Int      @default(0) // in hours
  thumbnailURL    String?
  price           Float    @default(0.0)
  currency        String   @default("USD")
  enrollmentCount Int      @default(0)
  rating          Float    @default(0.0)
  ratingCount     Int      @default(0)
  isPublished     Boolean  @default(false)
  createdBy       String   @default("system")
  coTeacherIds    String[] @db.ObjectId // teachers who may edit and mark this course, but not delete it
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modules     Module[]
  enrollments Enrollment[]
  certificates Certificate[]
  payments    Payment[]
}

model Module {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  order       Int      @default(0)
  courseId    String   @db.ObjectId
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  lessons     Lesson[]
  quizResults QuizResult[]
}

model Lesson {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  type        String   @default("video") // video, reading, quiz, assignment, project
  duration    Int      @default(0)       // minutes
  order       Int      @default(0)
  videoUrl    String?
  content     String?
  moduleId    String   @db.ObjectId
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  
  progress    Progress[]
}

model Enrollment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  courseId    String   @db.ObjectId
  status      String   @default("active") // active, completed, dropped
  rating      Float?   // the student's own 0-5 rating; course.rating averages these
  enrolledAt  DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Progress {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  lessonId        String   @db.ObjectId
  currentPosition Int      @default(0) // seconds
  totalDuration   Int      @default(0)
  isCompleted     Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model ChatSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
}

model ChatMessage {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  sessionId   String      @db.ObjectId
  role        String      // "user" or "assistant"
  content     String
  timestamp   DateTime    @default(now())
  
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  courseId    String?  @db.ObjectId
  amount      Float
  currency    String   @default("USD")
  status      String   // "succeeded", "pending", "failed"
  stripePiId  String   @unique
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
}

model Certificate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  courseId    String   @db.ObjectId
  title       String
  issueDate   DateTime @default(now())
  certificateUrl String?
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  title       String
  message     String
  isRead      Boolean  @default(false)
  type        String   @default("system") // system, course, payment
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuizResult {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  moduleId    String   @db.ObjectId
  score       Int
  totalQuestions Int
  passed      Boolean
  takenAt     DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model AdminBroadcast {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String
  type      String   @default("info")
  sentAt    DateTime @default(now())
}


model PasswordReset {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tokenHash String    @unique // sha256 of the emailed token; the raw token is never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Quizzes/assignments are keyed by lesson. lessonId is a plain string because
// course-level finals use synthetic ids like "final_test_<courseId>".
model Quiz {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId     String
  moduleId     String   @default("")
  lessonId     String   @unique
  title        String
  description  String   @default("")
  questions    Json     // [{questionId, questionText, type, options[{optionId,text}], correctOptionIndex, correctAnswer, explanation, points}]
  timeLimit    Int      @default(0)
  passingScore Int      @default(70)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions  QuizSubmission[]
}

model QuizSubmission {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  quizId       String   @db.ObjectId
  answers      Json
  score        Int      // percentage, computed on the server
  earnedPoints Int
  totalPoints  Int
  passed       Boolean
  timeSpent    Int?
  submittedAt  DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
}

model Assignment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId     String
  moduleId     String   @default("")
  lessonId     String   @unique
  title        String
  description  String   @default("")
  instructions String   @default("")
  dueDate      DateTime
  maxPoints    Int      @default(100)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions  AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  userId       String     @db.ObjectId
  assignmentId String     @db.ObjectId
  content      String
  fileUrl      String?
  feedback     String?
  score        Int?
  isGraded     Boolean    @default(false)
  gradedBy     String?    // "ai", or the teacher's user id; a teacher's mark can't be replaced by a resubmission
  submittedAt  DateTime   @default(now())
  gradedAt     DateTime?

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([userId, assignmentId])
}

model Bookmark {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  courseId        String   @db.ObjectId
  lessonId        String?  // null = the whole course
  title           String
  note            String?
  positionSeconds Int?     // video timestamp
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

}

model LearningPath {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  level       String   @default("beginner")
  skills      String[]
  courseIds   String[] @db.ObjectId // ordered
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ForumThread {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  authorId        String   @db.ObjectId
  courseId        String?  @db.ObjectId
  category        String   @default("general")
  title           String
  body            String
  tags            String[]
  upvoterIds      String[] @db.ObjectId
  replyCount      Int      @default(0)
  acceptedReplyId String?  @db.ObjectId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author          User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies         ForumReply[]
}

model ForumReply {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  threadId   String      @db.ObjectId
  authorId   String      @db.ObjectId
  body       String
  upvoterIds String[]    @db.ObjectId
  createdAt  DateTime    @default(now())

  thread     ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
